#: src/Plugin/Commerce/PaymentGateway/Multi.php:60
msgid "PAYMENT OPTIONS"
msgstr "OPÇÕES DE PAGAMENTO"

#: src/Plugin/Commerce/PaymentGateway/Multi.php:65
msgid "1st installment"
msgstr "1° pagamento"

#: src/Plugin/Commerce/PaymentGateway/Multi.php:66
msgid "Amount of first installment, in percentage of total amount. If empty, all installments will have the same amount."
msgstr "Valor do primeiro pagamento em percentagem do total. Se vazio, todos os pagamentos terão o mesmo valor."

#: src/Plugin/Commerce/PaymentGateway/Multi.php:72
msgid "Count"
msgstr "Contagem"

#: src/Plugin/Commerce/PaymentGateway/Multi.php:73
msgid "Total number of payments."
msgstr "Quantidade total de pagamentos."

#: src/Plugin/Commerce/PaymentGateway/Multi.php:79
msgid "Period"
msgstr "Período"

#: src/Plugin/Commerce/PaymentGateway/Multi.php:80
msgid "Delay (in days) between installments."
msgstr "Prazo entre dois pagamentos (em dias)."

#: src/Plugin/Commerce/PaymentGateway/Multi.php:86
msgid "ATTENTION: The payment in installments feature activation is subject to the prior agreement of Société Générale.<br />If you enable this feature while you have not the associated option, an error 10000 – INSTALLMENTS_NOT_ALLOWED or 07 - PAYMENT_CONFIG will occur and the buyer will not be able to pay."
msgstr "ATENÇÃO: A ativação do recurso de pagamento parcelado é sujeita ao acordo prévio da Société Générale.<br />Se você ativar este recurso sem ter a opção associada, ocorrerá um erro 10000 – INSTALLMENTS_NOT_ALLOWED ou 07 - PAYMENT_CONFIG e o comprador não poderá realizar o pagamento."

#: src/Plugin/Commerce/PaymentGateway/Multi.php:134
#: src/Plugin/Commerce/PaymentGateway/Payzen.php:431
#, php-format
msgid "Invalid value « %1$s » for field « %2$s »."
msgstr "Valor inválido « %1$s » para o campo « %2$s »."

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:55
#: src/Plugin/Commerce/PaymentGateway/Payzen.php:57
msgid "Redirection to shop in a few seconds..."
msgstr "Redirecionamento para a loja em poucos segundos..."

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:101
msgid "MODULE INFORMATION"
msgstr "INFORMAÇÕES SOBRE O MÓDULO"

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:105
msgid "Developed by"
msgstr "Desenvolvido por"

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:110
msgid "Contact us"
msgstr "Entre em contato conosco"

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:120
msgid "Module version"
msgstr "Versão do módulo"

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:125
msgid "Click here"
msgstr "Clique aqui"

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:148
msgid "Click to view the module configuration documentation: "
msgstr "Clique para consultar a documentação da configuração do módulo: "

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:166
msgid "PAYMENT GATEWAY ACCESS"
msgstr "ACESSO À PLATAFORMA"

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:171
msgid "Shop ID"
msgstr "Código loja"

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:172
msgid "The identifier provided by PayZen."
msgstr "Código dado pelo PayZen."

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:182
msgid "Key in test mode"
msgstr "Chave em modo teste"

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:183
msgid "Key provided by PayZen for test mode (available in PayZen Back Office)."
msgstr "Chave dada pelo PayZen para o modo teste (disponível no Back Office PayZen)."

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:193
msgid "Key in production mode"
msgstr "Chave no modo de produção"

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:194
msgid "Key provided by PayZen (available in PayZen Back Office after enabling production mode)."
msgstr "Chave dada pelo PayZen (disponível no Back Office PayZen após passar em produção)."

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:202
msgid "Mode"
msgstr "Modo"

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:203
msgid "The context mode of this module."
msgstr "O modo de contexto deste módulo."

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:205
msgid "TEST"
msgstr "TEST"

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:206
msgid "PRODUCTION"
msgstr "PRODUCTION"

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:218
msgid "Signature algorithm"
msgstr "Algoritmo de assinatura"

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:219
msgid "Algorithm used to compute the payment form signature. Selected algorithm must be the same as one configured in the PayZen Back Office.<br /><b>The HMAC-SHA-256 algorithm should not be activated if it is not yet available in the PayZen Back Office, the feature will be available soon.</b>"
msgstr "Algoritmo usado para calcular a assinatura do formulário de pagamento. O algoritmo selecionado deve ser o mesmo que foi configurado no Back Office PayZen.<br/><b>O HMAC-SHA-256 não deve estar ativo enquanto não estiver disponível no Back Office PayZen, a funcionalidade será disponível em breve.</b>"

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:233
msgid "Instant Payment Notification URL"
msgstr "URL de notificação"

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:236
msgid "URL to copy into your PayZen Back Office > Settings > Notification rules.<br />In multistore mode, notification URL is the same for all the stores."
msgstr "URL para copiar no Back Office PayZen > Configurações > Regras de notificações.<br />Em modo multi-loja, a URL de notificação é a mesma para todas as lojas."

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:254
msgid "PAYMENT PAGE"
msgstr "PÁGINA DE PAGAMENTO"

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:259
msgid "Default language"
msgstr "Idioma por default"

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:260
msgid "Default language on the payment page."
msgstr "Idioma default na página de pagamento."

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:268
msgid "Available languages"
msgstr "Idiomas disponíveis"

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:269
msgid "Languages available on the payment page. If you do not select any, all the supported languages will be available."
msgstr "Idiomas disponíveis na página de pagamento. Se não selecionar nenhum, todos os idiomas suportados estarão disponíveis."

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:276
msgid "Capture delay (if applicable)"
msgstr "Prazo antes da captura no banco (se aplicável)"

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:277
msgid "The number of days before the bank capture (adjustable in your PayZen Back Office)."
msgstr "A quantidade de dias antes da captura no banco (configurável no seu Back Office PayZen)."

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:283
msgid "Validation mode (if applicable)"
msgstr "Modo de validação (se aplicável) (se aplicável)"

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:284
msgid "If manual is selected, you will have to confirm payments manually in your PayZen Back Office."
msgstr "Em modo manual, deve confirmar os pagamentos no Back Office PayZen."

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:286
msgid "PayZen Back Office configuration"
msgstr "Configuração Back Office PayZen"

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:287
msgid "Automatic"
msgstr "Automático"

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:288
msgid "Manual"
msgstr "Manual"

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:296
msgid "Card Types"
msgstr "Tipos de cartões"

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:297
msgid "The card type(s) that can be used for the payment. Select none to use gateway configuration."
msgstr "O(s) tipo(s) de cartão que pode(m) ser usado(s) para o pagamento. Selecionar nada para usar a configuração da plataforma."

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:320
msgid "RETURN TO SHOP"
msgstr "VOLTAR PARA A LOJA"

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:325
msgid "Automatic redirection"
msgstr "Redirecionamento automático"

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:326
msgid "If enabled, the buyer is automatically redirected to your site at the end of the payment."
msgstr "Se estiver ativado, o comprador será automaticamente redirecionado para seu site no final do pagamento."

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:328
msgid "Disabled"
msgstr "Desativo"

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:329
msgid "Enabled"
msgstr "Ativo"

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:336
msgid "Redirection timeout on success"
msgstr "Tempo máximo antes do redirecionamento em caso de pagamento sucedido"

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:337
msgid "Time in seconds (0-300) before the buyer is automatically redirected to your website after a successful payment."
msgstr "Tempo em segundos (0-300) antes do redirecionamento automático do seu comprador para seu site após um pagamento realizado com sucesso."

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:348
msgid "Redirection message on success"
msgstr "Mensagem de redirecionamento em caso de sucesso"

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:349
msgid "Message displayed on the payment page prior to redirection after a successful payment."
msgstr "Mensagem exibida na página de pagamento antes do redirecionamento após um pagamento sucedido."

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:360
msgid "Redirection timeout on failure"
msgstr "Tempo máximo antes do redirecionamento em caso de pagamento não sucedido"

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:361
msgid "Time in seconds (0-300) before the buyer is automatically redirected to your website after a declined payment."
msgstr "Tempo em segundos (0-300) antes do redirecionamento automático do seu comprador para seu site após um pagamento não sucedido."

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:372
msgid "Redirection message on failure"
msgstr "Mensagem de redirecionamento após um pagamento não sucedido"

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:373
msgid "Message displayed on the payment page prior to redirection after a declined payment."
msgstr "Mensagem exibida na página de pagamento antes do redirecionamento após um pagamento não sucedido."

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:429
#, php-format
msgid "The field « %s » is mandatory."
msgstr "O campo « %s » é obrigatório."

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:535
msgid "GOING INTO PRODUCTION"
msgstr "PASSAR EM PRODUÇÃO"

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:536
msgid "You want to know how to put your shop into production mode, please read chapters « Proceeding to test phase » and « Shifting the shop to production mode » in the documentation of the module."
msgstr "Para saber como passar sua loja em modo de produção, favor ler os capítulos « Prosseguir para a fase de teste » e « Passar a loja em modo de produção » na documentação do módulo."

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:558
msgid "The shop is in maintenance mode. The automatic notification cannot work."
msgstr "A loja está em modo de manutenção. A notificação automática não está funcionando."

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:560
msgid "The automatic validation has not worked. Have you correctly set up the notification URL in your PayZen Back Office ?"
msgstr "A validação automática não foi realizada com sucesso. Você configurou corretamente a URL de notificação no PayZen Back Office ?"

#: src/Plugin/Commerce/PaymentGateway/Payzen.php:562
msgid "For understanding the problem, please read the documentation of the module : <br />&nbsp;&nbsp;&nbsp;- Chapter « To read carefully before going further »<br />&nbsp;&nbsp;&nbsp;- Chapter « Notification URL settings »"
msgstr "Para entender o problema, favor ler a documentação do módulo : <br />&nbsp;&nbsp;&nbsp;- Capítulo &laquo; Ler com atenção antes de continuar &raquo;<br />&nbsp;&nbsp;&nbsp;- Capítulo &laquo; Configurações da URL de notificação &raquo;"

